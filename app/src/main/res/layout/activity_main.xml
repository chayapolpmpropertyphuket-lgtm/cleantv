<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="56dp"
    android:paddingTop="40dp"
    android:paddingEnd="56dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- แถบบน: คำทักทาย / วันที่ / นาฬิกา / ปุ่มตั้งค่า -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEEE d MMMM"
                android:format24Hour="EEEE d MMMM"
                android:textColor="#9CA3AF"
                android:textSize="16sp" />
        </LinearLayout>

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:fontFamily="sans-serif-light"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFF"
            android:textSize="44sp" />

        <ImageButton
            android:id="@+id/settingsBtn"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/card_bg"
            android:contentDescription="การตั้งค่า"
            android:focusable="true"
            android:foreground="@drawable/card_focus"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_preferences"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="แอปของคุณ"
        android:textColor="#E5E7EB"
        android:textSize="18sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/appGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="40dp" />
</LinearLayout>